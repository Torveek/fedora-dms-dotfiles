# Fedora DMS Dotfiles Configuration
# Defines repositories, packages, directories, and dotfiles tracked by backup/restore.

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DATA_DIR="${REPO_ROOT}/data"
DOTFILES_DIR="${REPO_ROOT}/dotfiles"
LIB_DIR="${REPO_ROOT}/lib"

# Safety backup directory on restore
RESTORE_BACKUP_BASE="${HOME}/.dotfiles_backup"

# Phase 1: DMS Installation Method
# "auto"   - Official DankLinux automatic installer (curl -fsSL https://install.danklinux.com | sh)
# "manual" - Direct COPR enablement and DNF RPM package installation
DMS_INSTALL_METHOD="auto"

# Official DankLinux Installer Settings
DMS_INSTALLER_URL="https://install.danklinux.com"
DMS_INSTALLER_COMPOSITOR="niri"
DMS_INSTALLER_TERM="alacritty"
DMS_INSTALLER_ALL_FEATURES=true
DMS_SETUP_GREETER=true
DMS_INSTALLER_EXTRA_FLAGS=()

# Phase 1: DMS Priority COPR Repositories (used in manual mode / fallback)
DMS_PRIORITY_COPRS=(
    "avengemedia/danklinux"
    "avengemedia/dms"
    "yalter/niri"
)

# Phase 1: DMS Priority RPM Packages
DMS_PRIORITY_PACKAGES=(
    "dms"
    "dms-cli"
    "dms-greeter"
    "quickshell"
    "matugen"
    "dgop"
    "niri"
    "xwayland-satellite"
)

# Phase 1: Priority DMS & Niri Config Dirs (relative to ~/.config)
DMS_PRIORITY_CONFIG_DIRS=(
    "DankMaterialShell"
    "niri"
)

# Tracked ~/.config directories (excluding DMS priority, which are handled in dms_phase)
TRACKED_CONFIG_DIRS=(
    "alacritty"
    "cava"
    "doublecmd"
    "fastfetch"
    "fontconfig"
    "gtk-3.0"
    "gtk-4.0"
    "lazygit"
    "nvim"
    "qt5ct"
    "qt6ct"
    "xsettingsd"
)

# Single tracked files in ~/.config
TRACKED_CONFIG_FILES=(
    "starship.toml"
    "mimeapps.list"
)


# Tracked home files (relative to ~/)
TRACKED_HOME_FILES=(
    ".bashrc"
    ".bash_profile"
    ".gitconfig"
    ".xprofile"
    ".gtkrc-2.0"
)

# Tracked fonts directory (relative to ~/.local/share/)
TRACKED_FONTS_DIR="fonts"

# Flatpak default remotes
DEFAULT_FLATHUB_URL="https://dl.flathub.org/repo/flathub.flatpakrepo"
